+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from experiments.motion_fixture.bounded_sampling import run
+from experiments.motion_fixture.biomechanical_profile import pending_profile
+
+
+class BoundedSamplingTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        self.root=Path(self.tmp.name)/'private_artifacts'
+
+    def execute(self,name,**kwargs):
+        return run(self.root/name,seed=19,max_attempts=3,timeout_seconds=30,profile=pending_profile(),**kwargs)
+
+    def test_same_seed_recipes_and_all_rejections_are_reproducible(self):
+        a=self.execute('a');b=self.execute('b')
+        self.assertEqual(a['attempts_n'],3);self.assertEqual(a['rejected_n'],3)
+        self.assertEqual(a['validated_pool_candidates_n'],0);self.assertFalse(a['release_allowed'])
+        self.assertEqual(a['states'],{'UNRESOLVED_LIMITS':3})
+        events=[json.loads(line) for line in (self.root/'a/attempts.private.jsonl').read_text().splitlines()]
+        self.assertEqual([e['event'] for e in events],['attempt_started','attempt_finished']*3)
+        self.assertTrue(all(len(e['reasons'])==9 for e in events if e['event']=='attempt_finished'))
+        for i in range(3):
+            name=f'attempt-{i:04d}.private.json'
+            self.assertEqual((self.root/'a'/name).read_bytes(),(self.root/'b'/name).read_bytes())
+        with self.assertRaises(FileExistsError):self.execute('a')
+
+    def test_failed_producer_is_logged_and_not_given_a_completed_summary(self):
+        with patch('experiments.motion_fixture.bounded_sampling.generate_motion',side_effect=RuntimeError('fixture failure')):
+            with self.assertRaises(RuntimeError):self.execute('failed')
+        events=[json.loads(line) for line in (self.root/'failed/attempts.private.jsonl').read_text().splitlines()]
+        self.assertEqual([e['event'] for e in events],['attempt_started','attempt_error'])
+        self.assertFalse((self.root/'failed/summary.json').exists())
+
+    def test_deadline_stops_new_attempts_and_does_not_relax_rules(self):
+        with patch('experiments.motion_fixture.bounded_sampling.time.monotonic',side_effect=[0.,31.,32.]):
+            result=self.execute('deadline')
+        self.assertEqual(result['attempts_n'],0);self.assertEqual(result['stop_reason'],'TIME_BUDGET')
+        self.assertEqual(result['validated_pool_candidates_n'],0)
+
+    def test_physical_profile_cannot_be_applied_to_uncalibrated_qa_units(self):
+        profile=pending_profile();profile['length_unit']='mm'
+        with self.assertRaises(ValueError):
+            run(self.root/'bad',seed=1,max_attempts=1,timeout_seconds=1,profile=profile)
+        self.assertFalse((self.root/'bad').exists())
