+++ b/experiments/motion_fixture/bounded_sampling.py
@@ -0,0 +1,97 @@
+"""Bounded, logged sampling of existing authored QA recipes; no model or pool release.
+
+Existing engineering variation is reused unchanged. Pending anatomical limits,
+physics and human feasibility keep every proposal out of a validated pool.
+"""
+import argparse
+from collections import Counter
+import json
+import math
+import os
+from pathlib import Path
+import time
+
+import numpy as np
+
+from dataset_pipeline.common import LANDMARK_NAMES
+from experiments.private_paths import inside_repository
+from .biomechanical_profile import assess,pending_profile,validate
+from .generate import generate_motion,VERSION as PRODUCER_VERSION
+
+VERSION='bounded_authored_recipe_diagnostic_v1'
+TEMPLATES=('index_flex','middle_flex','alternating')
+
+
+def write(path,value):
+    with path.open('x',encoding='utf8') as stream:
+        json.dump(value,stream,allow_nan=False,sort_keys=True);stream.write('\n')
+        stream.flush();os.fsync(stream.fileno())
+
+
+def run(output,*,seed,max_attempts,timeout_seconds,profile):
+    if type(seed) is not int or not 0<=seed<2**63:raise ValueError('Bounded integer seed required')
+    if type(max_attempts) is not int or not 1<=max_attempts<=1000:raise ValueError('Attempt budget 1..1000 required')
+    if type(timeout_seconds) not in (int,float) or not math.isfinite(timeout_seconds) or not 0<timeout_seconds<=3600:
+        raise ValueError('Finite time budget up to one hour required')
+    validate(profile)
+    if profile['length_unit']!='authored_units':raise ValueError('Existing QA producer uses authored units only')
+    output=Path(output).resolve()
+    if 'private_artifacts' not in output.parts or inside_repository(output):raise ValueError('Private output outside Git required')
+    output.mkdir(parents=True,exist_ok=False)
+    # Explicit PCG64 and separate recipe-choice / producer-seed streams.
+    choice_rng,seed_rng=[np.random.Generator(np.random.PCG64(s)) for s in np.random.SeedSequence(seed).spawn(2)]
+    started=time.monotonic();finished=[]
+    write(output/'config.private.json',{'version':VERSION,'producer_version':PRODUCER_VERSION,'seed':seed,
+        'rng':'PCG64','rng_streams':['template_choice','producer_seed'],'templates':list(TEMPLATES),
+        'max_attempts':max_attempts,'timeout_seconds':timeout_seconds,'frames':24,'fps':12,
+        'point_semantics':'articulated_joint21','length_unit':'authored_units','profile':profile,
+        'scope':'existing_authored_QA_variation_only_not_MANO_or_biological_generation'})
+    with (output/'attempts.private.jsonl').open('x',encoding='utf8') as ledger:
+        def event(value):
+            ledger.write(json.dumps(value,allow_nan=False,sort_keys=True)+'\n');ledger.flush();os.fsync(ledger.fileno())
+        for index in range(max_attempts):
+            if time.monotonic()-started>=timeout_seconds:break
+            recipe={'attempt_idx':index,'template':TEMPLATES[int(choice_rng.integers(len(TEMPLATES)))],
+                    'producer_seed':int(seed_rng.integers(0,2**63)),'frames':24,'fps':12}
+            event({'event':'attempt_started','utc_epoch_ns':time.time_ns(),'recipe':recipe})
+            try:
+                frames=generate_motion(recipe['template'],recipe['producer_seed'],24,12)
+                points=np.array([[[f['landmarks_world'][name][a] for a in ('x','y','z')] for name in LANDMARK_NAMES] for f in frames])
+                result=assess(points,[f['source_pts_ms']/1000 for f in frames],profile,handedness='right',
+                              length_unit='authored_units',point_semantics='articulated_joint21')
+                write(output/f'attempt-{index:04d}.private.json',{'recipe':recipe,'frames':frames,'assessment':result})
+                reasons=['UNRESOLVED_LIMIT:'+r for r in result['unresolved_rules']]
+                reasons+=['GEOMETRY:'+e['code'] for e in result['geometry_errors']]
+                reasons+=['RULE:'+v['rule'] for v in result['violations']]
+                reasons+=['UNVERIFIED_PHYSICAL_UNITS','UNCHECKED_SURFACE_COLLISION_PHYSICS','NO_HUMAN_FEASIBILITY_EVIDENCE']
+                row={'event':'attempt_finished','attempt_idx':index,'status':'REJECTED','state':result['state'],
+                     'reasons':sorted(set(reasons)),'declared_rules_pass':result['declared_rules_pass']}
+            except Exception as error:
+                event({'event':'attempt_error','attempt_idx':index,'error_type':type(error).__name__,
+                       'utc_epoch_ns':time.time_ns()})
+                # Preserve the failed attempt and propagate unexpected failures.
+                # No success summary is written for an incomplete diagnostic.
+                raise
+            if time.monotonic()-started>=timeout_seconds:row['reasons'].append('TIME_BUDGET_EXCEEDED')
+            event({**row,'utc_epoch_ns':time.time_ns()});finished.append(row)
+    summary={'version':VERSION,'scope':'authored_QA_sampler_and_rejection_ledger_only',
+        'stop_reason':'ATTEMPT_BUDGET' if len(finished)==max_attempts else 'TIME_BUDGET',
+        'attempts_n':len(finished),'rejected_n':len(finished),'validated_pool_candidates_n':0,
+        'states':dict(Counter(row['state'] for row in finished)),
+        'reason_counts':dict(Counter(r for row in finished for r in row['reasons'])),
+        'biological_validity_proven':False,'release_allowed':False,'model_used':False,'human_observations_n':0,
+        'elapsed_seconds':time.monotonic()-started}
+    write(output/'summary.json',summary);return summary
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True);parser.add_argument('--seed',type=int,required=True)
+    parser.add_argument('--max-attempts',type=int,required=True);parser.add_argument('--timeout-seconds',type=float,required=True)
+    parser.add_argument('--profile',type=Path)
+    args=parser.parse_args()
+    profile=json.loads(args.profile.read_text()) if args.profile else pending_profile()
+    print(json.dumps(run(args.output,seed=args.seed,max_attempts=args.max_attempts,timeout_seconds=args.timeout_seconds,profile=profile)))
+
+
+if __name__=='__main__':main()
